<!DOCTYPE html>
<html lang="pl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}Maintly{% endblock %}</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background-color: #f4f4f4;
            padding: 20px;
        }
        .email-container {
            max-width: 600px;
            margin: 0 auto;
            background-color: #ffffff;
            border-radius: 8px;
            box-shadow: 0 2px 8px rgba(0,0,0,0.1);
            overflow: hidden;
        }
        .header {
            background: linear-gradient(135deg, #4472C4 0%, #2E5AAE 100%);
            color: #ffffff;
            padding: 30px;
            text-align: center;
        }
        .header h1 {
            font-size: 28px;
            font-weight: 600;
            margin-bottom: 5px;
        }
        .header p {
            font-size: 14px;
            opacity: 0.9;
        }
        .content {
            padding: 40px 30px;
            color: #333333;
            line-height: 1.6;
        }
        .content h2 {
            color: #4472C4;
            font-size: 22px;
            margin-bottom: 20px;
        }
        .content p {
            margin-bottom: 15px;
            font-size: 15px;
        }
        .button {
            display: inline-block;
            padding: 12px 30px;
            background-color: #4472C4;
            color: #ffffff;
            text-decoration: none;
            border-radius: 5px;
            font-weight: 600;
            margin: 20px 0;
            transition: background-color 0.3s;
        }
        .button:hover {
            background-color: #2E5AAE;
        }
        .info-box {
            background-color: #f8f9fa;
            border-left: 4px solid #4472C4;
            padding: 15px;
            margin: 20px 0;
            border-radius: 4px;
        }
        .info-box strong {
            color: #4472C4;
        }
        .footer {
            background-color: #f8f9fa;
            padding: 20px 30px;
            text-align: center;
            color: #666666;
            font-size: 13px;
            border-top: 1px solid #e0e0e0;
        }
        .footer p {
            margin: 5px 0;
        }
        .footer a {
            color: #4472C4;
            text-decoration: none;
        }
    </style>
</head>
<body>
    <div class="email-container">
        <div class="header">
            <h1>{% block header_title %}Maintly{% endblock %}</h1>
            <p>{% block header_subtitle %}System Zarządzania Konserwacją{% endblock %}</p>
        </div>
        
        <div class="content">
            {% block content %}{% endblock %}
        </div>
        
        <div class="footer">
            <p><strong>Maintly</strong> - System Zarządzania Konserwacją</p>
            <p>Ta wiadomość została wygenerowana automatycznie. Prosimy nie odpowiadać na ten email.</p>
            <p>&copy; {{ "now"|date("Y") }} Maintly. Wszelkie prawa zastrzeżone.</p>
        </div>
    </div>
</body>
</html>
