<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ title }}</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        
        body {
            font-family: 'DejaVu Sans', Arial, sans-serif;
            font-size: 10pt;
            color: #333;
            padding: 20px;
        }
        
        .header {
            text-align: center;
            margin-bottom: 30px;
            border-bottom: 2px solid #4472C4;
            padding-bottom: 15px;
        }
        
        .header h1 {
            color: #4472C4;
            font-size: 22pt;
            margin-bottom: 10px;
        }
        
        .header .meta {
            color: #666;
            font-size: 9pt;
        }
        
        .filters {
            background-color: #f8f9fa;
            padding: 10px 15px;
            margin-bottom: 20px;
            border-left: 4px solid #4472C4;
        }
        
        .filters h3 {
            font-size: 11pt;
            margin-bottom: 8px;
            color: #4472C4;
        }
        
        .filters p {
            margin: 3px 0;
            font-size: 9pt;
        }
        
        table {
            width: 100%;
            border-collapse: collapse;
            margin-bottom: 20px;
        }
        
        table thead {
            background-color: #4472C4;
            color: white;
        }
        
        table thead th {
            padding: 10px;
            text-align: left;
            font-weight: bold;
            border: 1px solid #2c5aa0;
        }
        
        table tbody td {
            padding: 8px 10px;
            border: 1px solid #ddd;
        }
        
        table tbody tr:nth-child(even) {
            background-color: #f8f9fa;
        }
        
        table tbody tr:hover {
            background-color: #e9ecef;
        }
        
        .summary {
            background-color: #e7f3ff;
            padding: 15px;
            border-radius: 5px;
            margin-top: 20px;
        }
        
        .summary h3 {
            color: #4472C4;
            margin-bottom: 10px;
            font-size: 12pt;
        }
        
        .summary p {
            margin: 5px 0;
            font-size: 10pt;
        }
        
        .footer {
            margin-top: 30px;
            padding-top: 15px;
            border-top: 1px solid #ddd;
            text-align: center;
            font-size: 8pt;
            color: #999;
        }
    </style>
</head>
<body>
    {% block content %}
        <div class="header">
            <h1>{{ title }}</h1>
            <div class="meta">
                <p>Generated: {{ generatedAt|date('Y-m-d H:i:s') }}</p>
            </div>
        </div>

        {% if filters is not empty %}
        <div class="filters">
            <h3>Applied Filters</h3>
            {% for key, value in filters %}
                <p><strong>{{ key|title }}:</strong> {{ value }}</p>
            {% endfor %}
        </div>
        {% endif %}

        <table>
            <thead>
                <tr>
                    {% for column in columns %}
                        <th>{{ column }}</th>
                    {% endfor %}
                </tr>
            </thead>
            <tbody>
                {% for row in rows %}
                    <tr>
                        {% for cell in row %}
                            <td>{{ cell }}</td>
                        {% endfor %}
                    </tr>
                {% endfor %}
            </tbody>
        </table>

        {% if summary is defined and summary.total is defined %}
        <div class="summary">
            <h3>Summary</h3>
            <p><strong>Total Records:</strong> {{ summary.total }}</p>
        </div>
        {% endif %}

        <div class="footer">
            <p>Generated by ReportGenerator</p>
        </div>
    {% endblock %}
</body>
</html>
