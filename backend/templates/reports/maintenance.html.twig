{% extends 'reports/base.html.twig' %}

{% block content %}
    <div class="header">
        <h1>{{ title }}</h1>
        <div class="meta">
            <p>Generated: {{ generatedAt|date('Y-m-d H:i:s') }}</p>
        </div>
    </div>

    {% if filters is not empty %}
    <div class="filters">
        <h3>Applied Filters</h3>
        {% if filters.status is defined %}
            <p><strong>Status:</strong> {{ filters.status }}</p>
        {% endif %}
        {% if filters.dateFrom is defined %}
            <p><strong>Date From:</strong> {{ filters.dateFrom }}</p>
        {% endif %}
        {% if filters.dateTo is defined %}
            <p><strong>Date To:</strong> {{ filters.dateTo }}</p>
        {% endif %}
        {% if filters.equipmentId is defined %}
            <p><strong>Equipment ID:</strong> {{ filters.equipmentId }}</p>
        {% endif %}
    </div>
    {% endif %}

    <table>
        <thead>
            <tr>
                {% for column in columns %}
                    <th>{{ column }}</th>
                {% endfor %}
            </tr>
        </thead>
        <tbody>
            {% for row in rows %}
                <tr>
                    {% for cell in row %}
                        <td>{{ cell }}</td>
                    {% endfor %}
                </tr>
            {% else %}
                <tr>
                    <td colspan="{{ columns|length }}" style="text-align: center; padding: 20px; color: #999;">
                        No maintenance records found matching the criteria.
                    </td>
                </tr>
            {% endfor %}
        </tbody>
    </table>

    {% if summary is defined and summary.total is defined %}
    <div class="summary">
        <h3>Summary</h3>
        <p><strong>Total Records:</strong> {{ summary.total }}</p>
    </div>
    {% endif %}

    <div class="footer">
        <p>Generated by ReportGenerator</p>
    </div>
{% endblock %}
