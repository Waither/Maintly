# PHPStan Configuration
# https://phpstan.org/config-reference

parameters:
    # ==========================================
    # LEVEL (0-9, 9 = strictest)
    # ==========================================
    level: 6
    # Level 0: Basic (undefined functions, classes)
    # Level 1: Undefined variables
    # Level 2: Unknown methods
    # Level 3: Return types
    # Level 4: Dead code
    # Level 5: Function arguments
    # Level 6: Missing typehints ← YOUR CHOICE (optimal)
    # Level 7: Union types
    # Level 8: Nullable types
    # Level 9: Mixed types (very strict)
    
    # ==========================================
    # ŚCIEŻKI DO ANALIZY
    # ==========================================
    paths:
        - ../src
        - ../tests
    
    # ==========================================
    # WYKLUCZENIA
    # ==========================================
    excludePaths:
        - ../src/Kernel.php              # Symfony kernel (autogenerated)
        - ../tests/bootstrap.php          # Bootstrap (may have edge cases)
    
    # ==========================================
    # IGNORE SPECIFIC ERRORS
    # ==========================================
    ignoreErrors:
        # Doctrine auto-generates IDs after persist, PHPStan doesn't see this
        - '#Property App\\Entity\\[a-zA-Z]+::\$id \(int\|null\) is never assigned int#'
    
    # ==========================================
    # CACHE
    # ==========================================
    tmpDir: ../var/cache/phpstan
