# PHPStan Configuration
# https://phpstan.org/config-reference

parameters:
    # ==========================================
    # LEVEL (0-9, 9 = najostrzejsze)
    # ==========================================
    level: 6
    # Level 0: Podstawowe (undefined functions, classes)
    # Level 1: Undefined variables
    # Level 2: Unknown methods
    # Level 3: Return types
    # Level 4: Dead code
    # Level 5: Argumenty funkcji
    # Level 6: Missing typehints ← TWÓJ WYBÓR
    # Level 7: Union types
    # Level 8: Nullable types
    # Level 9: Mixed types (prawie niemożliwe)
    
    # ==========================================
    # ŚCIEŻKI DO ANALIZY
    # ==========================================
    paths:
        - src
        - tests
    
    # ==========================================
    # WYKLUCZENIA
    # ==========================================
    excludePaths:
        - src/Kernel.php              # Symfony kernel (autogenerowany)
        - tests/bootstrap.php          # Bootstrap (może mieć edge cases)
    
    # ==========================================
    # BŁĘDY I OSTRZEŻENIA
    # ==========================================
    ignoreErrors:
        # Doctrine property access (magic getters/setters)
        - '#Access to an undefined property [a-zA-Z0-9\\_]+::\$[a-zA-Z]+#'
        
        # Symfony container (service locator pattern)
        - '#Service "[a-zA-Z0-9\\.]+" is private#'
    
    # ==========================================
    # CACHE
    # ==========================================
    tmpDir: var/cache/phpstan
