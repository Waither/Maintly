###> symfony/framework-bundle ###
APP_ENV=dev
# Generate with: php bin/console generate:secret
APP_SECRET=CHANGE_ME_TO_RANDOM_SECRET
###< symfony/framework-bundle ###

###> symfony/routing ###
DEFAULT_URI=http://localhost
###< symfony/routing ###

###> doctrine/doctrine-bundle ###
# Format: mysql://user:password@host:port/database?serverVersion=X.X&charset=utf8mb4
DATABASE_URL="mysql://maintly:secret@mysql:3306/maintly?serverVersion=8.0&charset=utf8mb4"
###< doctrine/doctrine-bundle ###

###> lexik/jwt-authentication-bundle ###
JWT_SECRET_KEY=%kernel.project_dir%/config/jwt/private.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt/public.pem
# Leave empty if keys generated without passphrase
JWT_PASSPHRASE=
###< lexik/jwt-authentication-bundle ###

###> nelmio/cors-bundle ###
# Regex pattern for allowed origins (localhost + port variants)
CORS_ALLOW_ORIGIN='^https?://(localhost|127\.0\.0\.1)(:[0-9]+)?$'
###< nelmio/cors-bundle ###

###> symfony/messenger ###
# Doctrine transport for async messages (uses database)
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0
###< symfony/messenger ###

###> symfony/lock ###
# Lock mechanism for rate limiting and distributed locks
# flock = filesystem locks (simple, works in dev)
# For production consider: redis://localhost or database
LOCK_DSN=flock
###< symfony/lock ###

###> symfony/mailer ###
# Mailer DSN for sending emails
# null://null = emails not sent, only logged (development)
# Production examples:
# MAILER_DSN=gmail+smtp://username:password@default
# MAILER_DSN=sendgrid+api://YOUR_KEY@default
# MAILER_DSN=smtp://user:pass@smtp.example.com:587
MAILER_DSN=null://null
###< symfony/mailer ###
