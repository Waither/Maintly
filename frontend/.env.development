# Backend API URL (z perspektywy PRZEGLĄDARKI, nie kontenera!)

# HTTP (domyślne - szybsze podczas dev)
VITE_API_URL=http://localhost:8000/api

# HTTPS (jeśli chcesz testować SSL)
# VITE_API_URL=https://localhost:8443/api

# WebSocket (dla real-time updates)
VITE_WS_URL=wss://localhost:3000/ws

# VAPID Public Key (push notifications)
VITE_VAPID_PUBLIC_KEY=your-vapid-key-here

# Włącz HTTPS dev server
VITE_USE_HTTPS=true