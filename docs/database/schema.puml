@startuml Maintly_CMMS_Database

' ============================================
' LAYOUT - kierunek i spacing
' ============================================
skinparam nodesep 120
skinparam ranksep 120

' ============================================
' STYLING - profesjonalny wygląd
' ============================================
skinparam linetype ortho
skinparam backgroundColor #F8F9FA
skinparam classBackgroundColor #FFFFFF
skinparam classBorderColor #2C3E50
skinparam classBorderThickness 2
skinparam arrowColor #34495E
skinparam arrowThickness 1.5
skinparam shadowing false
skinparam roundcorner 5
skinparam packageStyle rectangle

' Kolorowanie modułów
skinparam class {
  BackgroundColor<<user>> #E8F5E9
  BackgroundColor<<equipment>> #E3F2FD
  BackgroundColor<<workorder>> #FFF3E0
  BackgroundColor<<system>> #F3E5F5
  BorderColor<<user>> #4CAF50
  BorderColor<<equipment>> #2196F3
  BorderColor<<workorder>> #FF9800
  BorderColor<<system>> #9C27B0
}

!define table(x) class x << (T,#FFAAAA) >>
!define primary_key(x) <b><color:red>PK:</color> x</b>
!define foreign_key(x) <color:blue>FK:</color> x
hide methods
hide stereotypes

' ============================================
' USER MANAGEMENT - 👥 Module
' ============================================
package "USER MANAGEMENT" #E8F5E9 {
  table(user_roles) <<user>> {
    primary_key(id): int
    --
    name: varchar(50) <<unique>>
    created_at: datetime
  }

  table(users) <<user>> {
    primary_key(id): int
    --
    email: varchar(180) <<unique>>
    password: varchar(255)
    first_name: varchar(100)
    last_name: varchar(100)
    is_active: boolean
    created_at: datetime
    updated_at: datetime
    deleted_at: datetime
    --
    foreign_key(user_role_id): int
  }

  users }o--|| user_roles
}

' ============================================
' EQUIPMENT MODULE - 🔧 Module
' ============================================
package "EQUIPMENT MANAGEMENT" #E3F2FD {
  table(equipment) <<equipment>> {
    primary_key(id): int
    --
    name: varchar(255)
    cost_center: int
    qr_code_data: varchar(255) <<unique>>
    direct_work_time: int
    total_work_time: int
    created_at: datetime
    updated_at: datetime
    deleted_at: datetime
    --
    foreign_key(parent_equipment_id): int
    foreign_key(created_by): int
    foreign_key(updated_by): int
  }

  equipment }o--o| equipment
  equipment }o--|| users
  equipment }o--o| users

  table(tag_groups) <<equipment>> {
    primary_key(id): int
    --
    name: varchar(100) <<unique>>
    is_required: boolean
    is_single_choice: boolean
    display_order: int
    created_at: datetime
  }

  table(tags) <<equipment>> {
    primary_key(id): int
    --
    name: varchar(100) <<unique>>
    color: varchar(7)
    created_at: datetime
    --
    foreign_key(tag_group_id): int
  }

  tags }o--o| tag_groups

  table(equipment_tags) <<equipment>> {
    primary_key(id): int
    --
    assigned_at: datetime
    --
    foreign_key(equipment_id): int
    foreign_key(tag_id): int
    foreign_key(assigned_by): int
  }

  equipment ||--o{ equipment_tags
  tags ||--o{ equipment_tags
  users ||--o{ equipment_tags

  table(equipment_custom_fields) <<equipment>> {
    primary_key(id): int
    --
    field_name: varchar(100) <<unique>>
    field_type: varchar(20)
    field_options: json
    is_required: boolean
    default_value: text
    display_order: int
    is_active: boolean
    created_at: datetime
    deleted_at: datetime
    --
    foreign_key(created_by): int
  }

  equipment_custom_fields }o--|| users

  table(equipment_custom_values) <<equipment>> {
    primary_key(id): int
    --
    value: text
    created_at: datetime
    updated_at: datetime
    --
    foreign_key(equipment_id): int
    foreign_key(custom_field_id): int
  }

  equipment ||--o{ equipment_custom_values
  equipment_custom_fields ||--o{ equipment_custom_values

  table(equipment_files) <<equipment>> {
    primary_key(id): int
    --
    file_name: varchar(255)
    file_type: varchar(50)
    file_size: bigint
    description: text
    uploaded_at: datetime
    deleted_at: datetime
    --
    foreign_key(equipment_id): int
    foreign_key(uploaded_by): int
  }

  equipment ||--o{ equipment_files
  users ||--o{ equipment_files
}

' ============================================
' WORK ORDER MODULE - 📋 Module
' ============================================
package "WORK ORDER MANAGEMENT" #FFF3E0 {
  table(work_order_statuses) <<workorder>> {
    primary_key(id): int
    --
    name: varchar(50) <<unique>>
    color: varchar(7)
    display_order: int
    is_final: boolean
    created_at: datetime
  }

  table(work_order_priorities) <<workorder>> {
    primary_key(id): int
    --
    name: varchar(50) <<unique>>
    color: varchar(7)
    display_order: int
    created_at: datetime
  }

  table(work_orders) <<workorder>> {
    primary_key(id): int
    --
    unique_code: varchar(20) <<unique>>
    title: varchar(255)
    description: text
    planned_start_date: datetime
    planned_end_date: datetime
    actual_start_date: datetime
    actual_end_date: datetime
    created_at: datetime
    updated_at: datetime
    deleted_at: datetime
    --
    foreign_key(status_id): int
    foreign_key(priority_id): int
    foreign_key(equipment_id): int
    foreign_key(created_by): int
    foreign_key(updated_by): int
  }

  work_orders }o--|| work_order_statuses
  work_orders }o--|| work_order_priorities
  work_orders }o--|| equipment
  work_orders }o--|| users
  work_orders }o--o| users

  table(work_order_assignments) <<workorder>> {
    primary_key(id): int
    --
    assigned_at: datetime
    --
    foreign_key(work_order_id): int
    foreign_key(user_id): int
    foreign_key(assigned_by): int
  }

  work_orders ||--o{ work_order_assignments
  users ||--o{ work_order_assignments
  users ||--o{ work_order_assignments

  table(work_order_tags) <<workorder>> {
    primary_key(id): int
    --
    assigned_at: datetime
    --
    foreign_key(work_order_id): int
    foreign_key(tag_id): int
    foreign_key(assigned_by): int
  }

  work_orders ||--o{ work_order_tags
  tags ||--o{ work_order_tags
  users ||--o{ work_order_tags

  table(work_order_activities) <<workorder>> {
    primary_key(id): int
    --
    description: text
    time_spent: int
    completed_at: datetime
    created_at: datetime
    updated_at: datetime
    deleted_at: datetime
    --
    foreign_key(work_order_id): int
    foreign_key(performed_by): int
    foreign_key(created_by): int
  }

  work_orders ||--o{ work_order_activities
  users ||--o{ work_order_activities
  users ||--o{ work_order_activities

  table(work_order_files) <<workorder>> {
    primary_key(id): int
    --
    file_name: varchar(255)
    file_type: varchar(50)
    file_size: bigint
    description: text
    uploaded_at: datetime
    deleted_at: datetime
    --
    foreign_key(work_order_id): int
    foreign_key(uploaded_by): int
  }

  work_orders ||--o{ work_order_files
  users ||--o{ work_order_files
}

' ============================================
' TRANSLATIONS - 🌐 System Module
' ============================================
package "SYSTEM" #F3E5F5 {
  table(translations) <<system>> {
    primary_key(id): int
    --
    locale: varchar(5)
    message_key: varchar(255)
    message_value: text
    created_at: datetime
  }
}

' ============================================
' LEGEND
' ============================================
legend right
  **MAINTLY CMMS - Database Schema**
  ====
  **17 Tables** | **3NF Normalized**
  ----
  <color:#4CAF50>■</color> User Management (2 tables)
  <color:#2196F3>■</color> Equipment Management (6 tables)
  <color:#FF9800>■</color> Work Order Management (8 tables)
  <color:#9C27B0>■</color> System (1 table)
  ====
  Framework: Symfony 7 + Doctrine ORM
endlegend

@enduml
